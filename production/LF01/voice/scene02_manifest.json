  "take": "S02-07_A03f2_机遙_s22.mp3",
  "asr": "是。",
  "sim": 1.0,
  "f0": 123
 },
 {
  "key": "S02-06_A03f2_裴含章",
  "spk": "裴含章",
  "text": "新芽都在東廊。順著左手邊的迴廊走到底就是。",
  "file": "batch-v9/final/S02-06_A03f2_裴含章.mp3",
  "pitch_shift": 0.0,
  "take": "S02-08_A03f2_裴含章_s22.mp3",
  "asr": "新芽都在东廊，顺着左手边的回廊走到底就是。",
  "sim": 0.95,
  "f0": 219
 },
 {
  "key": "S02-07_A03f2_机遙",
  "spk": "机遙",
  "text": "新芽？",
