[
 {
  "key": "S02-01_A02f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "去年，我也站在這裡。",
  "file": null
 },
 {
  "key": "S02-02_A02f2_考官助手閃回",
  "spk": "考官助手（閃回）",
  "text": "……步法不穩。",
  "file": null
 },
 {
  "key": "S02-03_A02f2_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "今年，是第二次。",
  "file": null
 },
 {
  "key": "S02-04_A03f2_裴含章",
  "spk": "裴含章",
  "text": "青嵐新契修，机遙。東廊，第七室。",
  "file": null
 },
 {
  "key": "S02-05_A03f2_机遙",
  "spk": "机遙",
  "text": "是。",
  "file": null
 },
 {
  "key": "S02-06_A03f2_裴含章",
  "spk": "裴含章",
  "text": "新芽都在東廊。順著左手邊的迴廊走到底就是。",
  "file": null
 },
 {
  "key": "S02-07_A03f2_机遙",
  "spk": "机遙",
  "text": "新芽？",
  "file": null
 },
 {
  "key": "S02-08_A03f2_裴含章",
  "spk": "裴含章",
  "text": "剛冒頭，還沒長。去年也有個孩子這樣問我。",
  "file": null
 },
 {
  "key": "S02-09_A03f2_机遙",
  "spk": "机遙",
  "text": "……他後來呢？",
  "file": null
 },
 {
  "key": "S02-10_A03f2_裴含章",
  "spk": "裴含章",
  "text": "今年又來排隊了。",
  "file": null
 },
 {
  "key": "S02-11_A04f2_陸鳴鸞",
  "spk": "陸鳴鸞",
  "text": "抱歉抱歉！——你第幾室？",
  "file": null
 },
 {
  "key": "S02-12_A04f2_机遙",
  "spk": "机遙",
  "text": "第七。",
  "file": null
 },
 {
  "key": "S02-13_A04f2_陸鳴鸞",
  "spk": "陸鳴鸞",
  "text": "第七？我隔壁！那間吵死了，祝你好運！",
  "file": null
 },
 {
  "key": "S02-14_A04f2_演武場遠",
  "spk": "演武場（遠）",
  "text": "出——收——轉——定！",
  "file": null
 },
 {
  "key": "S02-15_A05f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "想了一整年要說什麼……結果一句都沒準備。",
  "file": null
 },
 {
  "key": "S02-16_A05f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "你就是新來的？",
  "file": "final/03_A05_齊衡烈.mp3"
 },
 {
  "key": "S02-17_A05f2_机遙",
  "spk": "机遙",
  "text": "應該是。",
  "file": "final/04_A05_机遙.mp3"
 },
 {
  "key": "S02-18_A06f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "那就對了。第七室最近正缺個能打的。",
  "file": "final/05_A06_齊衡烈.mp3"
 },
 {
  "key": "S02-19_A06f2_郁岑燁",
  "spk": "郁岑燁",
  "text": "你看都沒看他出手，怎麼知道他能打？",
  "file": "final/06_A06_郁岑燁.mp3"
 },
 {
  "key": "S02-20_A07f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "所以才要打一場啊。",
  "file": "final/07_A07_齊衡烈.mp3"
 },
 {
  "key": "S02-21_A07f2_郁岑燁",
  "spk": "郁岑燁",
  "text": "……無聊。",
  "file": "final/08_A07_郁岑燁.mp3"
 },
 {
  "key": "S02-22_A08f1_厲若楓",
  "spk": "厲若楓",
  "text": "別急。他的腳步有點亂。",
  "file": null
 },
 {
  "key": "S02-23_A08f2_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "步法不穩……揹了一年山路，還是被看出來了。",
  "file": null
 },
 {
  "key": "S02-24_A08f2_机遙",
  "spk": "机遙",
  "text": "你們都看得出來？",
  "file": "final/10_A08_机遙.mp3"
 },
 {
  "key": "S02-25_A09f1_郁岑燁",
  "spk": "郁岑燁",
  "text": "至少我看得出來。",
  "file": "final/11_A09_郁岑燁.mp3"
 },
 {
  "key": "S02-26_A09f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "哈哈，那更好！明天演武場見。",
  "file": "final/12_A09_齊衡烈.mp3"
 },
 {
  "key": "S02-27_A10f1_蕭曜霖畫外",
  "spk": "蕭曜霖（畫外）",
  "text": "不用等明天。",
  "file": "final/13_A10_蕭曜霖.mp3"
 },
 {
  "key": "S02-28_A10f2_蕭曜霖",
  "spk": "蕭曜霖",
  "text": "半刻鐘後，新生演武場集合。",
  "file": "final/14_A10_蕭曜霖.mp3"
 },
 {
  "key": "S02-29_A11f2_机遙",
  "spk": "机遙",
  "text": "這麼快？",
  "file": "final/15_A11_机遙.mp3"
 },
 {
  "key": "S02-30_A11f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "習慣就好。",
  "file": "final/16_A11_齊衡烈.mp3"
 },
 {
  "key": "S02-31_A12f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "喂，新來的。我叫齊衡烈。擦劍那個是郁岑燁，窗邊那個是厲若楓。你呢？",
  "file": null
 },
 {
  "key": "S02-32_A12f2_厲若楓",
  "spk": "厲若楓",
  "text": "……我自己會說。",
  "file": null
 },
 {
  "key": "S02-33_A12f2_机遙",
  "spk": "机遙",
  "text": "机遙。",
  "file": "final/18_A12_机遙.mp3"
 },
 {
  "key": "S02-34_A12f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "机遙。",
  "file": null
 },
 {
  "key": "S02-35_A12f2_郁岑燁",
  "spk": "郁岑燁",
  "text": "名字倒是比腳步穩。",
  "file": null
 },
 {
  "key": "S02-36_A12f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "行。走了，第一天就遲到，那個人會讓你後悔自己考進來。",
  "file": null
 },
 {
  "key": "S02-37_A12f3_机遙",
  "spk": "机遙",
  "text": "那個人是誰？",
  "file": null
 },
 {
  "key": "S02-38_A12f3_郁岑燁",
  "spk": "郁岑燁",
  "text": "蕭曜霖。戰技堂的教官。",
  "file": null
 },
 {
  "key": "S02-39_A12f3_厲若楓",
  "spk": "厲若楓",
  "text": "……走了。",
  "file": null
 },
 {
  "key": "S02-40_A12f4_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "第七室。",
  "file": null
 }
]