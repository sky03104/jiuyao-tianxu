  "f0": 137
 },
 {
  "key": "S02-08_A03f2_裴含章",
  "spk": "裴含章",
  "text": "剛冒頭，還沒長。去年也有個孩子這樣問我。",
  "file": "batch-v9/final/S02-08_A03f2_裴含章.mp3",
  "pitch_shift": 0.0,
  "take": "S02-10_A03f2_裴含章_s11.mp3",
  "asr": "刚冒头还没长，去年也有个孩子这样问我。",
  "sim": 1.0,
  "f0": 232
 },
 {
  "key": "S02-09_A03f2_机遙",
  "spk": "机遙",
  "text": "……他後來呢？",
