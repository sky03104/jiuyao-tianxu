[
 {
  "key": "S12-01_B01f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "地在震……",
  "file": null
 },
 {
  "key": "S12-02_B01f1_旁白",
  "spk": "旁白",
  "text": "那一日，古林裡所有活著的東西，都在往外走。",
  "file": null
 },
 {
  "key": "S12-03_B01f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "牠們連看都沒看我們一眼。",
  "file": null
 },
 {
  "key": "S12-04_B01f1_聞人澈",
  "spk": "聞人澈",
  "text": "別擋路，讓牠們過去。",
  "file": null
 },
 {
  "key": "S12-05_B01f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "它們在逃？",
  "file": "final/19_B01_齊衡烈.mp3"
 },
 {
  "key": "S12-06_B01f2_江祈璟",
  "spk": "江祈璟",
  "text": "不是逃。是在讓路。",
  "file": "final/20_B01_江祈璟.mp3"
 },
 {
  "key": "S12-07_B01f2_郁岑燁",
  "spk": "郁岑燁",
  "text": "讓給誰？",
  "file": null
 },
 {
  "key": "S12-08_B01f2_江祈璟",
  "spk": "江祈璟",
  "text": "讓給比牠們更可怕的東西。",
  "file": null
 },
 {
  "key": "S12-09_B01f2_厲若楓",
  "spk": "厲若楓",
  "text": "……來了。",
  "file": null
 },
 {
  "key": "S12-10_B01f2_厲若楓",
  "spk": "厲若楓",
  "text": "別動。誰都別先動。",
  "file": null
 },
 {
  "key": "S12-11_B02f1_旁白",
  "spk": "旁白",
  "text": "很多年後，在場的人說起這一天，最先想起的，都是那雙眼睛。",
  "file": null
 },
 {
  "key": "S12-12_B02f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "好高……牠甚至沒在看我們。牠在看陣眼。",
  "file": null
 },
 {
  "key": "S12-13_B02f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "牠在看什麼？",
  "file": null
 },
 {
  "key": "S12-14_B02f1_郁岑燁",
  "spk": "郁岑燁",
  "text": "那塊石頭。",
  "file": null
 },
 {
  "key": "S12-15_B02f2_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "……現在，牠在看我。",
  "file": null
 },
 {
  "key": "S12-16_B02f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "……現在牠在看你，新來的。",
  "file": null
 },
 {
  "key": "S12-17_B02f2_赤瞳妖將",
  "spk": "赤瞳妖將",
  "text": "……人族。你們也開始聽見了嗎？",
  "file": "final/21_B02_赤瞳妖將.mp3"
 },
 {
  "key": "S12-18_B02f2_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "聽見？剛才在陣眼……我看見的，是天空裂開。",
  "file": null
 },
 {
  "key": "S12-19_B02f2_机遙",
  "spk": "机遙",
  "text": "你在說什麼？",
  "file": "final/22_B02_机遙.mp3"
 },
 {
  "key": "S12-20_B02f2_江祈璟",
  "spk": "江祈璟",
  "text": "別跟牠說話。",
  "file": null
 },
 {
  "key": "S12-21_B03f1_聞人澈",
  "spk": "聞人澈",
  "text": "陣點失控了——全部退開！",
  "file": null
 },
 {
  "key": "S12-22_B03f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "管牠多高，先吃我一刀！",
  "file": null
 },
 {
  "key": "S12-23_B03f2_机遙",
  "spk": "机遙",
  "text": "齊衡烈！",
  "file": null
 },
 {
  "key": "S12-24_B03f2_齊衡烈",
  "spk": "齊衡烈",
  "text": "……什麼鬼力氣。",
  "file": null
 },
 {
  "key": "S12-25_B04f1_郁岑燁",
  "spk": "郁岑燁",
  "text": "牠在等我出手。",
  "file": null
 },
 {
  "key": "S12-26_B04f1_郁岑燁",
  "spk": "郁岑燁",
  "text": "別硬衝——牠看得見每一步。",
  "file": null
 },
 {
  "key": "S12-27_B04f2_厲若楓",
  "spk": "厲若楓",
  "text": "箭沒用，外殼太硬。",
  "file": null
 },
 {
  "key": "S12-28_B04f2_厲若楓",
  "spk": "厲若楓",
  "text": "換個角度——",
  "file": null
 },
 {
  "key": "S12-29_B04f2_厲若楓",
  "spk": "厲若楓",
  "text": "……還是一樣。",
  "file": null
 },
 {
  "key": "S12-30_B05f1_聞人澈",
  "spk": "聞人澈",
  "text": "撐不了多久……誰去把陣點斷掉！",
  "file": null
 },
 {
  "key": "S12-31_B05f2_江祈璟",
  "spk": "江祈璟",
  "text": "我左邊，你右邊。",
  "file": "final/23_B05_江祈璟.mp3"
 },
 {
  "key": "S12-32_B05f2_机遙",
  "spk": "机遙",
  "text": "你不是一直不服我？",
  "file": "final/24_B05_机遙.mp3"
 },
 {
  "key": "S12-33_B05f2_江祈璟",
  "spk": "江祈璟",
  "text": "現在不是比這個的時候。",
  "file": "final/25_B05_江祈璟.mp3"
 },
 {
  "key": "S12-34_B05f2_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "……也是。",
  "file": null
 },
 {
  "key": "S12-35_B05f2_江祈璟",
  "spk": "江祈璟",
  "text": "鈴響三聲，一起動手。",
  "file": null
 },
 {
  "key": "S12-36_B05f2_机遙",
  "spk": "机遙",
  "text": "好。",
  "file": null
 },
 {
  "key": "S12-37_B06f2_机遙",
  "spk": "机遙",
  "text": "右邊斷了！",
  "file": null
 },
 {
  "key": "S12-38_B06f2_江祈璟",
  "spk": "江祈璟",
  "text": "左邊也斷了！",
  "file": null
 },
 {
  "key": "S12-39_B07f1_郁岑燁",
  "spk": "郁岑燁",
  "text": "齊衡烈，第三個！",
  "file": null
 },
 {
  "key": "S12-40_B07f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "早就在等你這句！",
  "file": null
 },
 {
  "key": "S12-41_B07f2_聞人澈",
  "spk": "聞人澈",
  "text": "……牠停手了？",
  "file": null
 },
 {
  "key": "S12-42_B07f2_郁岑燁",
  "spk": "郁岑燁",
  "text": "不是停手。是牠不打了。",
  "file": null
 },
 {
  "key": "S12-43_B08f1_赤瞳妖將",
  "spk": "赤瞳妖將",
  "text": "這裡不是你們該來的地方。",
  "file": "final/26_B08_赤瞳妖將.mp3"
 },
 {
  "key": "S12-44_B08f2_旁白",
  "spk": "旁白",
  "text": "牠沒有回頭。也沒有一個人，敢追上去。",
  "file": null
 },
 {
  "key": "S12-45_B09f1_齊衡烈",
  "spk": "齊衡烈",
  "text": "……停不下來。",
  "file": null
 },
 {
  "key": "S12-46_B09f1_聞人澈",
  "spk": "聞人澈",
  "text": "活著就好。",
  "file": null
 },
 {
  "key": "S12-47_B09f1_江祈璟",
  "spk": "江祈璟",
  "text": "剛才那一刀，還行。",
  "file": null
 },
 {
  "key": "S12-48_B09f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "……他是在誇我？",
  "file": null
 },
 {
  "key": "S12-49_B09f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "牠說「你們也」。……所以在我們之前，也有人聽見過。",
  "file": null
 },
 {
  "key": "S12-50_B09f1_厲若楓",
  "spk": "厲若楓",
  "text": "回去。現在就走。",
  "file": null
 }
]