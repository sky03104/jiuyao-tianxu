  "take": "S12-12_B02f1_机遙心聲_s33.mp3",
  "asr": "好高，他甚至没在看我们，他在看阵眼。",
  "sim": 0.87,
  "f0": 135,
  "pitch_shift": 0.0
 },
 {
  "key": "S12-15_B02f2_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "……現在，牠在看我。",
  "file": "scene12-v2/final/S12-15_B02f2_机遙心聲.mp3",
  "take": "S12-15_B02f2_机遙心聲_s33.mp3",
  "asr": "现在他在看我。",
  "sim": 0.83,
  "f0": 91,
  "pitch_shift": 0.0
