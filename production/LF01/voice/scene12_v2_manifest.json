 {
  "key": "S12-02_B01f1_旁白",
  "spk": "旁白",
  "text": "那一日，古林裡所有活著的東西，都在往外走。",
  "file": "scene12-v2/final/S12-02_B01f1_旁白.mp3",
  "take": "S12-02_B01f1_旁白_s11.mp3",
  "asr": "那一日，古林里所有活着的东西都在往外走。",
  "sim": 0.94,
  "f0": 91,
  "pitch_shift": 0.0
 },
