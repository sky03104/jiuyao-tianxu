  "sim": 1.0,
  "f0": 74,
  "pitch_shift": 0.0
 },
 {
  "key": "S12-12_B02f1_机遙心聲",
  "spk": "机遙（心聲）",
  "text": "好高……牠甚至沒在看我們。牠在看陣眼。",
